# Local model via Ollama
OLLAMA_MODEL=qwen2.5-coder:latest
OLLAMA_THINK_MODEL=qwen3-coder:latest
OLLAMA_GENERAL_MODEL=gemma4:31b
OLLAMA_EXTRA_MODELS=deepseek-coder-v2:16b,deepseek-coder-v2:236b,qwen3.5:397b-cloud,minimax-m2.7:cloud
OLLAMA_MODELS_JSON=["qwen2.5-coder:latest","qwen3-coder:latest","gemma4:31b","deepseek-coder-v2:16b","deepseek-coder-v2:236b","qwen3.5:397b-cloud","minimax-m2.7:cloud"]

# OpenAI official API
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_LONG_CONTEXT_MODEL=gpt-4.1

# DeepSeek official API
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_REASONING_MODEL=deepseek-reasoner

# Qwen official API via DashScope compatible endpoint
DASHSCOPE_API_KEY=sk-your-dashscope-key
QWEN_MODEL=qwen3-coder-plus

# Router strategy
ROUTER_DEFAULT=ollama,qwen2.5-coder:latest
ROUTER_BACKGROUND=ollama,qwen2.5-coder:latest
ROUTER_THINK=deepseek,deepseek-reasoner
ROUTER_LONG_CONTEXT=ollama,gemma4:31b
