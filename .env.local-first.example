CLAUDE_CODE_LOCAL_FIRST=1
DISABLE_TELEMETRY=1
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
DISABLE_COST_WARNINGS=1

# Local Anthropic-compatible gateway endpoint
ANTHROPIC_BASE_URL=http://127.0.0.1:3456
ANTHROPIC_AUTH_TOKEN=local-router
API_TIMEOUT_MS=600000

# Local model labels shown in /model and status views
ANTHROPIC_MODEL=qwen3.5:35b
ANTHROPIC_DEFAULT_SONNET_MODEL=qwen3.5:35b
ANTHROPIC_DEFAULT_SONNET_MODEL_NAME=Qwen3.5 35b
ANTHROPIC_DEFAULT_SONNET_MODEL_DESCRIPTION=Default local coding model via the Anthropic-compatible gateway
ANTHROPIC_DEFAULT_SONNET_MODEL_SUPPORTED_CAPABILITIES=
ANTHROPIC_DEFAULT_OPUS_MODEL=qwen3.5:35b
ANTHROPIC_DEFAULT_OPUS_MODEL_NAME=Qwen3.5 35b
ANTHROPIC_DEFAULT_OPUS_MODEL_DESCRIPTION=Local reasoning model via the Anthropic-compatible gateway
ANTHROPIC_DEFAULT_OPUS_MODEL_SUPPORTED_CAPABILITIES=thinking
ANTHROPIC_DEFAULT_HAIKU_MODEL=gemma4:31b
ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME=Gemma4 31b
ANTHROPIC_DEFAULT_HAIKU_MODEL_DESCRIPTION=Fast local general-purpose model via the Anthropic-compatible gateway
ANTHROPIC_DEFAULT_HAIKU_MODEL_SUPPORTED_CAPABILITIES=
ANTHROPIC_CUSTOM_MODEL_OPTIONS=deepseek-coder:6.7b,deepseek-coder-v2:16b,deepseek-coder-v2:236b,qwen3.5:397b-cloud,minimax-m2.7:cloud
